#include <winres.h>
#include "wynpix_version.h"

IDI_ICON1               ICON    DISCARDABLE     "res/icons/common/logo/app/wynpix.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION WYNPIX_VERSION_MAJOR,WYNPIX_VERSION_MINOR,WYNPIX_VERSION_PATCH,WYNPIX_VERSION_TWEAK
PRODUCTVERSION WYNPIX_VERSION_MAJOR,WYNPIX_VERSION_MINOR,WYNPIX_VERSION_PATCH,WYNPIX_VERSION_TWEAK
FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
FILEFLAGS 0x1L
#else
FILEFLAGS 0x0L
#endif
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "hadoooooouken"
            VALUE "FileDescription", "Wynpix"
            VALUE "FileVersion", WYNPIX_VERSION_STRING
            VALUE "InternalName", "wynpix.exe"
            VALUE "LegalCopyright", "Copyright (C) 2026 hadooooouken"
            VALUE "OriginalFilename", "wynpix.exe"
            VALUE "ProductName", "Wynpix"
            VALUE "ProductVersion", WYNPIX_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
